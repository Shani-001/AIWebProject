# AI Web Signal Hunter - Environment Configuration Example
# Copy this file to .env and fill in your actual API keys

# AI Provider Selection: 'groq' or 'gemini'
DEFAULT_AI_PROVIDER=groq

# Groq API Configuration (Get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (Get from https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Crawler Configuration
MAX_PAGES_DEFAULT=25
CRAWL_TIMEOUT_SECONDS=10
CRAWL_DELAY_SECONDS=1.0
USER_AGENT=AI-Web-Signal-Hunter/1.0 (+https://github.com/internship/ai-web-signal-hunter)

# Database
DATABASE_PATH=data/signals.db
